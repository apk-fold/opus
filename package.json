{
  "name": "navi-violet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Opus — client Navidrome / Subsonic sur mesure (thème réglable, animations GSAP) empaqueté en APK avec Capacitor",
  "scripts": {
    "dev": "vite --host",
    "mock": "node dev/mock-server.mjs",
    "build": "vite build",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "sync": "vite build && cap sync android && node scripts/patch-android.mjs",
    "open": "cap open android",
    "android": "npm run sync && cap open android",
    "icons": "npx @capacitor/assets generate --android --iconBackgroundColor #05030a --iconBackgroundColorDark #05030a --splashBackgroundColor #05030a --splashBackgroundColorDark #05030a"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/app": "latest",
    "@capacitor/core": "latest",
    "@capacitor/filesystem": "latest",
    "@capacitor/haptics": "latest",
    "@capacitor/share": "latest",
    "@capacitor/status-bar": "latest",
    "@jofr/capacitor-media-session": "^4.0.0",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "vite": "^6.0.0"
  }
}
